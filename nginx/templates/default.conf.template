map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  server_name api.utm.local localhost;

  # Docker DNS
  resolver 127.0.0.11;

  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Port $server_port;

  location = / {
    return 302 /swagger-ui/;
  }

  location /organization/ {
    proxy_pass http://organization:8083/organization/;
  }

  location /api/v1/organizations {
    proxy_pass http://organization:8083/organization/api/v1/organizations;
  }

  location /drone/ {
    proxy_pass http://drone:8085/drone/;
  }

  location /api/v1/drones {
    proxy_pass http://drone:8085/drone/api/v1/drones;
  }

  location /hub/ {
    proxy_pass http://hub:8084/hub/;
  }

  location /api/v1/hubs {
    proxy_pass http://hub:8084/hub/api/v1/hubs;
  }

  location /flight/ {
    proxy_pass http://flight:8086/flight/;
  }

  location /api/v1/flights {
    proxy_pass http://flight:8086/flight/api/v1/flights;
  }

  location /airspace/ {
    proxy_pass http://airspace:8087/airspace/;
  }

  location /api/v1/airspace {
    proxy_pass http://airspace:8087/airspace/api/v1/airspace;
  }

  location /telemetry/ {
    proxy_pass http://telemetry:8089/telemetry/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /api/v1/telemetry {
    proxy_pass http://telemetry:8089/telemetry/api/v1/telemetry;
  }

  location /simulation/ {
    proxy_pass http://simulation:8090/simulation/;
  }

  location /api/v1/simulation {
    proxy_pass http://simulation:8090/simulation/api/v1/simulation;
  }

  location /conflict/ {
    proxy_pass http://conflict:8092/conflict/;
  }

  location /api/v1/conflicts {
    proxy_pass http://conflict:8092/conflict/api/v1/conflicts;
  }

  location /alert/ {
    proxy_pass http://alert:8093/alert/;
  }

  location /api/v1/alerts {
    proxy_pass http://alert:8093/alert/api/v1/alerts;
  }

  location /swagger-ui/ {
    proxy_pass http://swagger-ui:8080;
  }
}

server {
  server_name backoffice.utm.local backoffice;

  # Docker DNS
  resolver 127.0.0.11;

  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Port $server_port;

  location / {
    proxy_pass http://backoffice-bff:8082;
  }
}

server {
  server_name identity.utm.local identity;
  large_client_header_buffers 8 32k;
  location / {
    proxy_pass http://identity:80;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    if ($uri ~ "^(.*)/(protocol/openid-connect/auth|login/oauth2/code|protocol/openid-connect/token)(.*)") {
      add_header Access-Control-Allow-Origin *;
    }
  }
}

server {
  server_name pgadmin.utm.local;
  location / {
    proxy_pass http://pgadmin;
  }
}
