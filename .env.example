# Platform
ENV_PLATFORM=local
NGINX_PORT=8081

# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_LOCAL_PORT=54320

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

URLS=[{ url: '/organization/v3/api-docs', name: 'Organization Service' }, { url: '/drone/v3/api-docs', name: 'Drone Service' }, { url: '/hub/v3/api-docs', name: 'Hub Service' }, { url: '/flight/v3/api-docs', name: 'Flight Service' }, { url: '/airspace/v3/api-docs', name: 'Airspace Service' }, { url: '/telemetry/v3/api-docs', name: 'Telemetry Service' }, { url: '/simulation/v3/api-docs', name: 'Simulation Service' }, { url: '/conflict/v3/api-docs', name: 'Conflict Detection Service' }, { url: '/alert/v3/api-docs', name: 'Alert Service' }, { url: '/connectivity/v3/api-docs', name: 'Connectivity Service' }, { url: '/mission/v3/api-docs', name: 'Mission Service' }, { url: '/emergency/v3/api-docs', name: 'Emergency Service' }]

# Docker Compose default files
COMPOSE_FILE=docker-compose.yml
# Redis
REDIS_PORT=6379

# Backoffice
BACKOFFICE_PORT=3000
