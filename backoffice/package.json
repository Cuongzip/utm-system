{
  "name": "backoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-cesium": "node scripts/copy-cesium.mjs",
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\"",
    "codegen": "orval && node scripts/fix-codegen.mjs",
    "prepare": "node -e \"try { require('child_process').execSync('cd .. && git config core.hooksPath backoffice/.husky', {stdio:'ignore'}) } catch {}\""
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stomp/stompjs": "^7.5.0",
    "cesium": "^1.140.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "orval": "^7.13.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
